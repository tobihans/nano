{
  "name": "nano",
  "scripts": {
    "tailwind:build": "npx @tailwindcss/cli -i ui/app.css -o ui/dist/app.css --minify",
    "tailwind:watch": "npx @tailwindcss/cli -i ui/app.css -o ui/dist/app.css --watch --minify",
    "parcel:build": "npx parcel build",
    "parcel:watch": "npx parcel watch"
  },
  "dependencies": {
    "@imacrayon/alpine-ajax": "^0.12.4",
    "@tailwindcss/cli": "^4.1.12",
    "alpinejs": "^3.14.9",
    "basecoat-css": "^0.3.2",
    "tailwindcss": "^4.1.12"
  },
  "devDependencies": {
    "@iconify-json/tabler": "^1.2.22",
    "@iconify/tailwind4": "^1.0.6",
    "@types/alpinejs": "^3.13.11",
    "@types/node": "^24.3.0",
    "parcel": "^2.15.4",
    "tw-animate-css": "^1.3.7",
    "typescript": "^5.9.2"
  },
  "targets": {
    "default": {
      "context": "browser",
      "source": "ui/app.ts",
      "distDir": "ui/dist",
      "includeNodeModules": true,
      "sourceMap": false,
      "outputFormat": "esmodule",
      "isLibrary": false,
      "engines": {
        "browsers": "defaults"
      }
    }
  },
  "@parcel/resolver-default": {
    "packageExports": true
  }
}
